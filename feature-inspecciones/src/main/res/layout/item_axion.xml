<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@android:color/white"
    android:layout_marginBottom="4dp">

    <!-- Fila superior: número + descripción + botón VER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="48dp">

        <TextView
            android:id="@+id/tv_numero_axion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#0D2B6E"
            android:minWidth="48dp"
            android:paddingEnd="8dp"/>

        <TextView
            android:id="@+id/tv_descripcion_axion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#212121"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.3"/>

        <!-- Botón VER/OCULTAR — más grande y visible -->
        <TextView
            android:id="@+id/tv_hint_axion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼ VER"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#37474F"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Detalle colapsable (col D) — fondo azul claro -->
    <TextView
        android:id="@+id/tv_detalle_axion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#1A237E"
        android:background="#E8EAF6"
        android:padding="12dp"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"/>

    <!-- Botones OK / Observado -->
    <RadioGroup
        android:id="@+id/rg_estado_axion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rb_ok_axion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✔ OK"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rb_obs_axion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="⚠ Observado"
            android:textColor="#E65100"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CFD8DC"
        android:layout_marginTop="6dp"/>

</LinearLayout>
