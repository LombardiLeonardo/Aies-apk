<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MaterialComponents es requerido por MaterialDatePicker (usado en HistorialActivity)
         y por los widgets de com.google.android.material; el tema del :app host
         (Theme.Material.Light.NoActionBar) no alcanza, por eso cada Activity de este
         módulo lo declara explícitamente en el manifest. -->
    <style name="Theme.FeatureInspecciones" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
